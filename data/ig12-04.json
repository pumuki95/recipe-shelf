    [
     "Oven",
     "Preheat the oven to 350°F."
    ],
    [
     "Batter",
     "Mix the yogurt and eggs; mix the dry ingredients separately, combine and add warm water gradually until smooth and pourable."
    ],
    [
     "Chill",
     "Chill the batter 15 minutes, then spread in a parchment-lined 9×13-inch pan."
    ],
    [
     "Bake",
     "Bake 11–13 minutes until just set. Roll up warm in the parchment and let cool."
    ],
    [
     "Fill",
     "Unroll, spread with Cool Whip and roll back up."
    ],
    [
     "Frost",
     "Mix the frosting, spread over the roll and top with the crushed Oreos."
    ],
    [
     "Chill",
     "Refrigerate 1+ hour and slice into 12."
