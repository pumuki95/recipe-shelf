   "steps": [
    [
     "Marinate",
     "Mix the marinade in the baking dish and coat the chicken."
    ],
    [
     "Sauce",
     "Stir in all the sauce ingredients and wipe the sides of the dish."
    ],
    [
     "Bake",
     "Bake uncovered at 180°C fan / 200°C for 30–35 minutes, stirring halfway, until the chicken reaches 75°C and the sauce is deep orange."
    ],
    [
     "Pasta",
     "Meanwhile boil the pasta until al dente, saving a mug of pasta water."
    ],
    [
     "Finish",
     "Rest 1–2 minutes, stir in the evaporated milk and cream cheese, then the pasta (loosen with pasta water). Top with coriander and portion."
    ],
    [
     "Store",
     "Keeps 5–6 days in the fridge or can be frozen; microwave covered 2–3 minutes, then stir."
