    [
     "Press",
     "Divide the mince into 4 (70 g each) and press each thinly over one side of a mini tortilla. Season."
    ],
    [
     "Cook",
     "Fry mince-side down in a little oil over medium-high heat 3–5 minutes until browned and cooked."
    ],
    [
     "Cheese",
     "Flip, add a cheese slice and cook 1–2 minutes until crispy and melted."
    ],
    [
     "Sauce",
