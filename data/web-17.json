    [
     "Oven",
     "Preheat the oven to 400°F."
    ],
    [
     "Wet",
     "Whisk the egg, then whisk in the cottage cheese and vinegar."
    ],
    [
     "Dry",
     "Mix the flour, baking powder, garlic powder, salt and Italian seasoning."
    ],
    [
     "Dough",
     "Mix wet into dry until a soft dough forms (softer than bread dough)."
    ],
    [
     "Shape",
