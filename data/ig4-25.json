   "steps": [
    [
     "Batter",
     "Mix the pancake mix, protein powder, coconut flour and sweetener, then the egg whites, maple syrup and milk until smooth (add a splash of water if needed)."
    ],
    [
     "Swirl",
     "Mix the swirl ingredients until smooth and put in a piping bag with a small tip cut."
    ],
    [
     "Cook",
     "Heat a nonstick pan to medium-low with a sprayed 6-inch pancake ring. Add ¼ of the batter; once the top starts to set, pipe ¼ of the swirl in a spiral away from the edges."
    ],
    [
     "Flip",
     "Remove the ring, flip and cook 1–2 minutes more. Repeat for 4 pancakes."
    ],
    [
     "Ice",
     "Mix the powdered sweetener with water to a drizzle and pour over the warm pancakes."
    ]
