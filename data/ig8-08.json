   "steps": [
    [
     "Slow cooker",
     "Add the beef, Rotel, onion, bone broth and all the seasonings to the slow cooker and cook on High for 4 hours, breaking up the beef."
    ],
    [
     "Rice",
     "Stir in the rice (measured dry) with enough liquid to cook it, and let it cook through in the slow cooker."
    ],
    [
     "Cheese",
     "Stir in the reduced-fat cheddar."
    ],
    [
     "Queso",
     "Blend the cottage cheese, cream cheese, mac & cheese powder, chipotles and a splash of broth until smooth, then stir it into the beef and rice."
    ],
    [
     "Wrap",
     "Fill and roll 18 burritos, wrap them and refrigerate or freeze for the week."
    ]
