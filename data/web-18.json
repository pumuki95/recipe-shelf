   "steps": [
    [
     "Oven",
     "Preheat the oven to 350°F and line an 8×4-inch loaf pan with parchment, leaving overhang."
    ],
    [
     "Dry",
     "Whisk the flour, baking powder, soda, salt, cinnamon and nutmeg."
    ],
    [
     "Wet",
     "Mash the bananas, blend the cottage cheese smooth and add with the eggs, maple syrup, butter and vanilla."
    ],
    [
     "Combine",
     "Stir wet into dry just until incorporated, then fold in the chocolate chips."
    ],
    [
     "Bake",
     "Pour in, top with extra chips and bake 50–60 minutes until a toothpick comes out clean; tent with foil for the last 15–20 minutes if browning fast."
    ],
    [
     "Cool",
     "Cool 15 minutes in the pan, lift out and cool completely before slicing."
    ]
