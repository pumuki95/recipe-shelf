   "steps": [
    [
     "Marinate",
     "Mix the chicken with the spices, honey, tomato paste, lemon juice and oil."
    ],
    [
     "Rice",
     "Soften the onion in the butter 5 minutes, toast the spices 3–4 minutes, then stir in the cooked rice off the heat."
    ],
    [
     "Tabbouleh",
     "Mix the parsley, tomatoes, green onion, oil, lemon and seasonings; chill."
    ],
    [
     "Chicken",
     "Bake on a lined sheet pan at 200°C (400°F) for 20–25 minutes, then broil 5 minutes."
    ],
    [
     "Sauce",
     "Whisk the yogurt, mayo, chili garlic sauce, spices and evaporated milk."
    ],
    [
     "Serve",
     "Portion rice, chicken and tabbouleh into 6 bowls with the sauce on the side."
    ]
