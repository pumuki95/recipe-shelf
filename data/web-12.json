    [
     "Dough",
     "Mix the cottage cheese, flour, baking powder and lemon zest to a soft dough, then gently fold in the blueberries."
    ],
    [
     "Shape",
     "With damp hands roll into about 16 balls."
    ],
    [
     "Air fry",
     "Air fry in a greased basket at 350°F (175°C) for 8–9 minutes, in batches if needed, until lightly golden."
    ],
    [
     "Glaze",
     "Whisk the icing sugar, lemon juice and vanilla. Dip the warm donut holes, let set, then dust with powdered sugar."
