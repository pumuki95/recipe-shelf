   "steps": [
    [
     "Potatoes",
     "Toss the diced potatoes with oil, garlic powder, smoked paprika, salt and pepper and air fry (about 400°F, 18–20 minutes, shaking halfway) until crispy."
    ],
    [
     "Steak",
     "Season the steak cubes with the oil, spices, lime, salt and pepper and sear in a hot pan until browned outside and done to your liking."
    ],
    [
     "Street corn",
     "Mix the corn with the yogurt, mayo, lime, cotija, chili powder and salt."
    ],
    [
     "Crema",
     "Blend all the crema ingredients until smooth, thinning with water."
    ],
    [
     "Assemble",
     "Divide potatoes, street corn and steak between 4 bowls, drizzle with crema and add toppings."
    ]
