   "steps": [
    [
     "Dough",
     "Mix the flour, yogurt, garlic salt and Italian seasoning into a dough, knead briefly and divide into 20 pieces."
    ],
    [
     "Beef",
     "Brown the beef with the onion, garlic and taco seasoning, then stir in the enchilada sauce and cheddar."
    ],
    [
     "Eggs",
     "Scramble the eggs with the seasonings, then fold in the cheddar, bacon and chives."
    ],
    [
     "Fill",
     "Roll out the dough, top half the rounds with beef, eggs and mozzarella, cover with the remaining rounds and seal the edges."
    ],
    [
     "Cook",
     "Cook in a skillet or bake at 400°F (200°C) until golden on both sides (about 4–5 minutes per side in a pan)."
    ],
    [
     "Freeze",
     "Wrap in foil or a freezer bag and freeze up to 3 months. Reheat wrapped in a damp paper towel in the microwave 3–4 minutes, then crisp in a pan or air fryer."
    ]
