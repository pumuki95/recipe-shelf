   "steps": [
    [
     "Marinate",
     "Season the steak with the spices, lime juice and oil and marinate at least 30 minutes."
    ],
    [
     "Potatoes",
     "Toss the potatoes with seasoning and oil and bake or air fry at 200°C (400°F) for 20–22 minutes."
    ],
    [
     "Steak",
     "Sear in butter over medium-high heat 2–3 minutes per side without crowding, then finish with more butter and garlic."
    ],
    [
     "Sauce",
     "Cook the garlic and onion 5 minutes until soft, stir in the herbs and chipotle, then over low heat stir in the milk, cream cheese and parmesan until smooth (no need to simmer)."
    ],
    [
