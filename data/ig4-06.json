   "steps": [
    [
     "Base",
     "Heat the oven to 400°F (200°C). In a 9×13 dish combine the rice, tomatoes, pepper, onion, garlic, broth, juice of half the lemon and half the seasoning; keep the rice submerged."
    ],
    [
     "Chicken",
     "Coat the chicken thighs in the rest of the seasoning and lay them on top in one layer."
    ],
    [
     "Bake",
     "Cover tightly with foil and bake 40–50 minutes until the rice is tender and the chicken reaches 165°F."
    ],
    [
     "Char",
     "Uncover and broil 2–4 minutes, watching closely."
    ],
    [
     "Finish",
     "Dice the chicken and stir the spinach and remaining lemon juice into the hot rice until wilted. Top with feta and parsley."
    ]
   ],
