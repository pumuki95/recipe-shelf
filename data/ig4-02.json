   "steps": [
    [
     "Marinate",
     "Toss the beef with the seasonings, baking soda, gochujang, sesame seeds, honey and both soy sauces."
    ],
    [
     "Sauce",
     "Whisk all the yum yum sauce ingredients and bottle it for the week."
    ],
    [
     "Steak",
     "Spread the steak and red onion on a lined sheet pan, spray with oil and bake at 200°C (400°F) for 15 minutes, then broil 5 minutes until caramelized."
    ],
    [
     "Veg",
     "Remove the steak, toss the vegetables in the pan juices and roast at 190°C (390°F) for 15 minutes."
    ],
    [
     "Fried rice",
     "While the tray is hot, add the garlic powder, cooked rice, green onion, soy sauces and butter and mix until fluffy."
    ],
    [
     "Portion",
     "Serve the rice with the steak and yum yum sauce, divided between 8 containers."
    ]
   ],
