    [
     "Beef",
     "Soften the onion, add the beef and garlic and brown it, then stir in the seasoning mix."
    ],
    [
     "Simmer",
     "Add the tomatoes and broth and simmer until thick, then stir in the cheddar and cilantro."
    ],
    [
     "Fill",
     "Lay out each tortilla with rice, beef filling and a tablespoon of nacho cheese sauce, then roll tightly."
    ],
    [
     "Grill the cheese",
