    [
     "Filling",
     "Mix the chicken, blended cottage cheese, buffalo sauce, mozzarella, green onion and seasonings."
    ],
    [
     "Soften",
     "Dip 2 rice paper sheets together in the egg wash just until they start to soften."
    ],
    [
     "Fold",
     "Add a big scoop of filling, fold in the sides, then the top and bottom to make a sealed rectangle."
    ],
    [
     "Bake",
     "Place seam-side up on parchment and bake at 450°F (230°C) for 10 minutes."
    ],
    [
