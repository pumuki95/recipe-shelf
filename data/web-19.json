   "steps": [
    [
     "Oven",
     "Preheat the oven to 350°F and lightly grease an 8-inch round pan."
    ],
    [
     "Dry",
     "Whisk the flour, both protein powders and baking powder."
    ],
    [
     "Wet",
     "Stir the Greek yogurt and pumpkin together until smooth, add to the dry and mix into rough crumbles."
    ],
    [
     "Knead",
     "Knead 30–45 seconds on a floured surface, just until smooth and not sticky."
    ],
    [
     "Roll",
     "Roll into a roughly 9×9-inch square about ⅓ inch thick, squaring off the edges."
    ],
    [
     "Filling",
     "Mix the sweetener, applesauce, butter, cinnamon and pumpkin spice and spread to the edges."
    ],
    [
     "Shape",
     "Cut into 6 strips about 1½ inches wide and roll each up tightly; lift with a knife if they stick."
    ],
    [
     "Bake",
     "Place in the pan with a little space, pour about 1 tsp almond milk over each and bake 30–32 minutes until puffed and just soft on top."
    ],
    [
     "Frost",
     "Cool 10 minutes. Stir the yogurt and protein powder (plus a splash of almond milk) and spread over the warm rolls."
    ]
   ],
