   "steps": [
    [
     "Bag",
     "Divide the green onions, ginger and garlic between freezer bags, then the chicken strips."
    ],
    [
     "Marinade",
     "Mix the remaining ingredients and pour evenly into the bags."
    ],
    [
     "Freeze",
     "Freeze flat (3–4 months) or refrigerate up to 24 hours before cooking. Thaw overnight in the fridge."
    ],
    [
     "Cook",
     "Heat a lightly oiled nonstick pan until very hot. Discard the garlic, ginger and excess marinade, then sear the chicken and green onions in a single layer, 1–2 minutes per side, and stir-fry 2–3 minutes more to 165°F. Work in batches."
    ],
