   "steps": [
    [
     "Dates",
     "Soak the pitted dates in hot water 10–15 minutes, then mash or blend into a paste and mix with the coconut oil, salt and cinnamon."
    ],
    [
     "Dough",
     "Mix the flour, baking soda and salt; in a bigger bowl mix the skyr and eggs, then combine until a dough starts to form."
    ],
    [
     "Knead",
     "Knead on a well-floured surface, adding flour a little at a time so it doesn't stick."
    ],
    [
     "Roll",
     "Roll into a large rectangle about ¼ inch thick, spread with the filling (leaving a border) and roll up tightly."
    ],
    [
     "Cut",
     "Cut into 10–11 pieces (thread or unflavoured floss gives the cleanest cut) and arrange in a buttered 9×12-inch pan with about an inch between them."
    ],
    [
     "Bake",
     "Bake at 350°F for 30–35 minutes until golden, then cool."
    ],
    [
     "Frost",
     "Whip the frosting ingredients until smooth and spread over the rolls."
    ]
