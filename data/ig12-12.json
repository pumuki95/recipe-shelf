   "steps": [
    [
     "Oven",
     "Preheat the oven to 170°C (340°F)."
    ],
    [
     "Sponge",
     "Whisk the eggs and sweetener, add the skyr, milk and vanilla, then fold in the flour, protein, cocoa, baking powder and salt."
    ],
    [
     "Bake",
     "Spread in a lined 20×20 cm tin and bake 10–13 minutes. Cool completely."
    ],
    [
     "Split",
     "Cut the sponge horizontally into two layers."
    ],
    [
     "Fill",
     "Mix the filling until smooth, spread on the bottom layer and add the top. Refrigerate at least 4 hours."
    ],
    [
     "Top",
     "Melt the chocolate with the coconut oil, spread over the top and chill until set. Cut into 4."
    ]
