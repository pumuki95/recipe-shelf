   "steps": [
    [
     "Beef",
     "Toss the steak with the soy sauce, pepper, cornflour and baking soda (freezing the steak 30 minutes first makes slicing easier)."
    ],
    [
     "Crisp",
     "Cook on high heat with cooking spray until golden and crispy on both sides, then set aside."
    ],
    [
     "Rice",
     "Cook the rice."
    ],
    [
     "Veg",
     "In the same pan cook the garlic, pepper and onion until just tender."
    ],
    [
     "Glaze",
     "Add the glaze ingredients and simmer until thick and glossy."
    ],
    [
     "Toss",
     "Return the beef and toss to coat. Divide over the rice in 4 containers and top with sesame seeds."
    ],
    [
     "Store",
     "Keeps 5 days in the fridge; add a teaspoon of water and microwave 3 minutes to reheat."
