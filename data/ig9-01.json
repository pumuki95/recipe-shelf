   "steps": [
    [
     "Oven",
     "Preheat the oven to 350°F (175°C) and lightly grease an 8-inch skillet."
    ],
    [
     "Wet",
     "Mix the butter, applesauce, syrup, egg and vanilla."
    ],
    [
     "Dough",
     "Add the flour, casein, oat flour, baking soda, salt and sweetener and mix into a thick cookie dough."
    ],
    [
     "Skillet",
     "Fold in the chocolate chips and press evenly into the skillet. Add extra chocolate on top if you like."
    ],
    [
     "Bake",
     "Bake 12–16 minutes, until the edges are golden and set but the centre is still slightly soft."
    ],
    [
     "Rest",
     "Cool 5–10 minutes before cutting."
