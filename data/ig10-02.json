   "steps": [
    [
     "Bacon",
     "Spread the bacon in a 9×13 dish and bake at 400°F about 20 minutes, stirring halfway, until crisp. Drain, pour off the grease and wipe the dish."
    ],
    [
     "Crescents",
     "Lower to 375°F and grease the dish. Roll up all 8 crescents, arrange in two rows of four and parbake 10–12 minutes until lightly golden."
    ],
    [
     "Egg mix",
     "Blend the eggs, egg whites, cottage cheese, Parmesan, chili paste and spices until smooth."
    ],
    [
     "Bake",
     "Set the dish on a sheet pan and slowly pour the egg mix around the crescents, leaving the tops exposed. Bake uncovered 30 minutes."
    ],
    [
     "Cheese",
     "Scatter both cheddars and the bacon on top and bake 10–15 minutes more, until melted and the centre reaches 165°F."
    ],
    [
     "Serve",
     "Rest 10 minutes, garnish with green onions and cut into 8 squares, one crescent each."
    ]
