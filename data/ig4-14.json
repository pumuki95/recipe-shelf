    [
     "Marinate",
     "Whisk the coconut milk, curry paste, curry powder, honey and salt, coat the chicken and marinate at least 2 hours, ideally overnight."
    ],
    [
     "Sauce",
     "Whisk the PB2 into the hot water until smooth, then add the coconut milk, curry paste, soy and lime; adjust to taste."
    ],
    [
     "Skewer",
     "Thread onto 8 skewers, about 60 g chicken each."
    ],
    [
     "Cook",
