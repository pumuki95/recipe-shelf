   "steps": [
    [
     "Chicken",
     "Season the chicken and cook in batches in the butter over medium-high heat, about 5 minutes per side, until golden. Set aside."
    ],
    [
     "Onions",
     "Cook the onions in butter 10–12 minutes, stirring every 4–5 minutes, until soft and caramelized."
    ],
    [
     "Sauce",
     "Add the seasonings, sundried tomatoes and garlic, lower the heat, then stir in the milk and cream cheese until smooth. Add the Parmesan and parsley and return the chicken."
    ],
    [
     "Rice",
     "Cook the rice, then toss with the butter, garlic, salt, herbs, lemon zest and juice."
    ],
    [
     "Pack",
     "Divide between 5 containers, with veg if you like."
    ]
