   "steps": [
    [
     "Apples",
     "Cook the apples with sweetener, cinnamon and water over medium-low for 5–7 minutes until soft; cool."
    ],
    [
     "Dough",
     "Mix the flour, yogurt, baking powder and cinnamon into a dough and knead on a well-floured surface."
    ],
    [
     "Fold in apples",
     "Roll out, spread the apples over, fold, cut both ways and gently fold together so the apples are mixed through."
    ],
    [
     "Shape",
     "Divide into 6–8 fritters, using flour as needed."
    ],
    [
     "Air fry",
     "Spray and air fry at 375°F for 8 minutes, flip, spray and cook 5–8 minutes more."
    ],
    [
     "Glaze",
     "Cool completely, dip both sides in the glaze and set on a rack."
    ]
