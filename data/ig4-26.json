   "steps": [
    [
     "Preheat",
     "Heat the oven to 350°F (175°C) and line a loaf pan."
    ],
    [
     "Mix",
     "Mix the wet ingredients (75 ml milk to start) until smooth, mix the dry separately, then combine. The batter should be thick and spreadable; add milk up to 90 ml if too dry."
    ],
    [
     "Bake",
     "Spread in the pan and bake 40–45 minutes until set and a toothpick comes out mostly clean; don't overbake."
    ],
    [
     "Frosting",
     "Mix the yogurt, cream cheese and powdered sweetener; chill while the loaf cools completely."
    ],
    [
     "Finish",
     "Frost, top with crushed Oreo and cut into 9 thick slices. Keep in the fridge."
    ]
