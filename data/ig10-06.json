   "steps": [
    [
     "Marinade",
     "Mix the gochujang, both soy sauces, mirin, vinegar, sugar, sesame oil and diced shallot and coat the chicken."
    ],
    [
     "Broth",
     "Gently simmer the broth with the ginger and torn lime leaves while the chicken cooks."
    ],
    [
     "Chicken",
     "Pan-fry the thighs over medium heat, turning, until cooked through and caramelized; lower the heat if the glaze darkens too fast."
    ],
    [
     "Herbs",
     "Toss the herbs, sliced shallot and chives with a little olive oil."
    ],
    [
     "Bowls",
     "Remove the lime leaves. Put rice in bowls, ladle the broth around it, then add sliced chicken and the herb salad. Finish with scallions and sesame seeds."
    ]
