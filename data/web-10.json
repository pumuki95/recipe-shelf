   "steps": [
    [
     "Oven",
     "Preheat the oven to 425°F and line a baking sheet."
    ],
    [
     "Blend",
     "Blend the cottage cheese until completely smooth."
    ],
    [
     "Dry",
     "Whisk the flour, baking powder, salt, garlic powder and pepper."
    ],
    [
     "Dough",
     "Add the cottage cheese, egg and oil and mix to a rough, sticky dough. Fold in the cheddar and rosemary."
    ],
    [
     "Rest",
     "Rest the dough 10–15 minutes."
    ],
    [
     "Bake",
     "Scoop 6 portions (about ⅓ cup each) onto the sheet and bake 18–20 minutes until golden."
    ],
    [
     "Finish",
     "Brush with melted butter and sprinkle with flaky salt and rosemary. Cool 5 minutes."
