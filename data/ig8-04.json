   "steps": [
    [
     "Crumble dough",
     "Mix the dry crumble ingredients so nothing clumps, then add the apple sauce and butter extract and mix into a crumbly dough."
    ],
    [
     "Air fry crumble",
     "Break it into granola-size pieces, spray, and air fry at 350°F for 2–3 minutes until lightly golden."
    ],
    [
     "Filling",
     "Mix the pie filling with the cinnamon and nutmeg and cut the apples into smaller pieces."
    ],
    [
     "Skillet",
     "Add a third of the apples to a 6.5-inch cast iron skillet and air fry at 350°F for 2–3 minutes."
    ],
    [
     "Top",
     "Add a third of the crumble and air fry another 2–3 minutes."
    ],
    [
     "Finish",
     "Mix the powdered sweetener with a little cold water into an icing. Dust the skillet with cinnamon-sweetener and drizzle with icing. Repeat for the other two skillets."
    ]
