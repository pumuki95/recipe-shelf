    [
     "Marinate",
     "Toss the diced chicken with the soy sauce, honey, oil and seasonings."
    ],
    [
     "Sauce",
     "Blend all the bang bang sauce ingredients until smooth and chill."
    ],
    [
     "Air fry",
     "Thread the chicken onto skewers and air fry at 400°F for 9–10 minutes, brushing with a little extra marinade after 7–8 minutes if you like."
    ],
    [
