   "steps": [
    [
     "Season chicken",
     "Cube the chicken breast and thighs, season with the salt, spices and olive oil and mix until the colour changes. Set aside."
    ],
    [
     "Roast potatoes",
     "Spread the potatoes and red onion on a large lined sheet pan, season, spray and roast at 400°F (200°C) for 20–22 minutes; they don't need to be fully cooked."
    ],
    [
     "Add chicken",
     "Spread the chicken over the potatoes in one layer, spray and roast 25 minutes until cooked and juicy."
    ],
    [
     "Sauce",
     "Straight out of the oven, add the milk, cream cheese and mozzarella and stir; the pan's heat melts it into a creamy sauce."
    ],
    [
     "Serve",
     "Garnish with parsley and Parmesan and divide into 8 containers."
    ]
