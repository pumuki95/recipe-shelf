   "steps": [
    [
     "Prep",
     "Heat the oven to 350°F (175°C) and spray two 5- or 6-inch springform pans."
    ],
    [
     "Cookie batter",
     "Mix the wet and dry cookie ingredients separately, then combine."
    ],
    [
     "Brownie batter",
     "Mix the brownie wet and dry separately, then combine without overmixing. Divide between the pans."
    ],
    [
     "Layer",
     "Dollop the cookie batter over the brownie, spread gently and add the chocolate chips."
    ],
    [
     "Bake",
     "Bake 28–38 minutes (6-inch) or 32–42 minutes (5-inch) until the edges are set and centers slightly soft."
    ],
    [
     "Cool",
     "Cool in the pans 30 minutes before releasing. Serve with ice cream and chocolate sauce if you like (not in the macros)."
    ]
   ],
   "notes": "Recipe and macros are the creator's, per brookie (net carbs). A whey/casein blend gives the fudgiest texture."
