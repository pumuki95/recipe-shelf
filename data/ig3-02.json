   "steps": [
    [
     "Marinate",
     "Toss the chicken with the olive oil, spices, salt, pepper, chipotle, honey and lime juice."
    ],
    [
     "Peppers & onions",
     "Cook the peppers and onion in a pan with cooking spray, salt, pepper and garlic powder until soft and lightly charred, then set aside."
    ],
    [
     "Chicken",
     "Cook the chicken in the same pan over medium-high heat for 8–10 minutes until cooked through and sticky, then stir the peppers and onions back in."
    ],
    [
     "Assemble",
     "Spoon the filling onto each tortilla, top with cheese and cilantro and roll up tightly, tucking in the sides."
    ],
    [
     "Sear",
     "Toast the burritos seam-side down in a pan over medium heat until golden on both sides."
    ],
    [
     "Chipotle ranch",
     "Blend the yogurt, ranch seasoning, chipotle, honey and lime juice, adding water until it's a drizzling or dipping consistency."
    ],
    [
     "Store",
     "Cool, wrap individually and refrigerate up to 4 days or freeze. Keep the sauce separate."
    ]
