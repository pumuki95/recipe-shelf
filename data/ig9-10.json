   "steps": [
    [
     "Oven",
     "Preheat the oven to 350°F and line a loaf pan or small baking dish."
    ],
    [
     "Wet",
     "Mash the bananas, then whisk in the eggs, yogurt, maple syrup, melted butter and vanilla."
    ],
    [
     "Dry",
     "Mix in the flour, whey, baking soda, baking powder, cinnamon and salt without overmixing, then fold in most of the chocolate chips."
    ],
    [
     "Bake",
     "Pour in, top with the remaining chips and bake about 45–55 minutes until a toothpick comes out clean."
    ],
    [
     "Cool",
