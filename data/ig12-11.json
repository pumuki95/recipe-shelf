   "steps": [
    [
     "Oven",
     "Preheat the oven to 350°F and line an 8.5×4.5-inch loaf pan with parchment."
    ],
    [
     "Whip",
     "Beat the eggs, yolk and sweeteners 4–5 minutes until thick, pale and glossy (this makes the crackly top)."
    ],
    [
     "Chocolate",
     "Melt the butter and chocolate chips together, cool slightly, then gently mix into the eggs."
    ],
    [
     "Dry",
     "Fold in the dry ingredients until just combined."
    ],
    [
     "Bake",
     "Bake 28–38 minutes until the top is crackly and the centre fudgy."
    ],
    [
     "Cool",
     "Cool completely, uncovered, before slicing."
