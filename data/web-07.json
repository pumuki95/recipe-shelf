    [
     "Dough",
     "Blend the cottage cheese and pumpkin until smooth, then mix in the flour and baking powder to a soft dough. Add a little flour if it's too sticky."
    ],
    [
     "Shape",
     "Roll into small, even balls."
    ],
    [
     "Air fry",
     "Air fry at 350°F for 9 minutes, spaced apart, until lightly golden and cooked through."
    ],
    [
     "Coat",
     "Mix the sugar and pumpkin spice. Brush or toss the warm donut holes in melted butter, then in the spiced sugar. Serve warm."
