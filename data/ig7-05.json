   "steps": [
    [
     "Velvet",
     "Toss the chicken with the velveting ingredients, marinate 20 minutes, then cook in batches in a lightly oiled wok until just done."
    ],
    [
     "Aromatics",
     "Fry the garlic and ginger in coconut oil 1–2 minutes over medium-low, then the curry paste 1–2 minutes over medium-high."
    ],
    [
     "Veg",
     "Stir in the sugar, then the onions, peppers, bamboo shoots and fish sauce until the onions soften."
    ],
    [
     "Simmer",
     "Add the water, then the coconut milk and bring to a gentle simmer without boiling."
    ],
    [
     "Finish",
     "Stir in the coconut extract and chicken for 1–2 minutes, then fold in the basil."
    ],
    [
     "Freeze",
     "Freeze in 1-cup molds, then bag for 3–4 months. Microwave a cube covered with up to ⅓ cup water for 4–8 minutes. Serve with rice, lime and cilantro."
    ]
   ],
   "notes": "Recipe and macros are the creator's, per 1-cup serving without rice. Curry paste heat and salt vary a lot by brand, so start with 200 g."
