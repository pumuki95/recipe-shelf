   "steps": [
    [
     "Bake",
     "Oil and season the chicken and onions and put them in a baking dish with the garlic heads. Cover with foil and bake at 200°C (180°C fan) until the chicken reaches 75°C."
    ],
    [
     "Caramelise",
     "Remove the foil and the chicken (shred it). Add the sun-dried tomatoes and return the onions and garlic to the oven 10–20 minutes until browned and caramelised."
    ],
    [
     "Sauce",
     "While warm, squeeze in the roasted garlic and stir in the parmesan, evaporated milk, cream cheese and parsley until creamy."
    ],
    [
     "Combine",
     "Add the cooked pasta, shredded chicken and lemon juice, mix and portion."
    ]
