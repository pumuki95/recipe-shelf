   "steps": [
    [
     "Filling",
     "Shred the chicken and add it to a bowl with the chives."
    ],
    [
     "Sauce",
     "Blend all the sauce ingredients until smooth, pour over the chicken and mix."
    ],
    [
     "Dough",
     "Mix the flour, yogurt, garlic salt and herbs into a dough, then knead 1–2 minutes on a floured bench until smooth."
    ],
    [
     "Roll",
     "Divide into 5 balls (about 104 g each) and roll each into an oval 3–4 mm thick."
    ],
    [
     "Fill",
     "Spoon the buffalo chicken onto one half, top with 39 g mozzarella, fold over and seal the edges with a fork."
    ],
    [
     "Cook",
     "Toast in a lightly oiled pan over medium-low heat, lid on, 4–5 minutes per side until golden and cooked through."
    ],
    [
     "Reheat",
     "Wrap in a damp paper towel and microwave 3–4 minutes from frozen or 1–2 from the fridge; crisp in a hot pan if you like."
    ]
