   "steps": [
    [
     "Season",
     "Cube the chicken and mix with the seasonings and olive oil."
    ],
    [
     "Pasta",
     "Boil the macaroni, reserve some pasta water and set aside."
    ],
    [
     "Chicken",
     "Cook the chicken in light butter over medium heat 10–12 minutes until golden. Lower the heat, add extra butter, the BBQ sauce, honey and parsley and cook until coated and caramelized."
    ],
    [
     "Sauce",
     "In a second pan, cook the butter, garlic and seasoning 3–4 minutes until fragrant. Add both milks, the hot sauce and cream cheese and stir until smooth, then add the cheddar and mozzarella."
    ],
