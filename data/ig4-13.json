   "steps": [
    [
     "Chicken",
     "Season and air fry the chicken at 400°F for 9–10 minutes to 165°F. Rest 10 minutes, then chop finely."
    ],
    [
     "Sauce",
     "Mix the yogurt, cheese wedges, chipotles, adobo and lime juice until smooth."
    ],
    [
     "Filling",
     "Fold in the chicken, onion, corn, beans and cilantro; adjust seasoning."
    ],
    [
     "Seal",
     "Brush egg white around the edge of a bread slice, add filling, top with a second brushed slice and crimp with a fork."
    ],
    [
     "Air fry",
     "Spray both sides and air fry at 400°F for 4–5 minutes until golden. Makes 6."
    ]
   ],
   "notes": "Recipe and macros are the creator's, per pocket. Sponsored by Oikos (any plain nonfat Greek yogurt works)."
