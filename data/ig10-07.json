   "steps": [
    [
     "Season",
     "Preheat the oven to 350°F. Put the chuck roast in a lidded oven-safe dish and season both sides generously with salt, pepper and all the spices."
    ],
    [
     "Braise",
     "Add the garlic cloves and bone broth, cover and cook 3 hours."
    ],
    [
     "Prep",
     "Meanwhile chop the vegetables and drain and rinse the chickpeas."
    ],
    [
     "Shred",
     "Shred the beef with two forks, mix in the vegetables and chickpeas, cover and cook at 400°F for 40 minutes, then uncover for 10–15 minutes to get some colour."
    ],
    [
     "Sauce",
     "Mix the yogurt, tahini, lemon, garlic and salt, adding water until drizzly."
    ],
    [
     "Serve",
     "Top with parsley, the tahini sauce, Aleppo pepper and lemon."
    ]
