   "steps": [
    [
     "Blend",
     "Blend all the base ingredients (40–45 g sweetener to taste) and freeze at least 16 hours."
    ],
    [
     "Thaw edge",
     "Run the pint under hot water for 30–60 seconds."
    ],
    [
     "Spin",
     "Spin on Lite Ice Cream; Re-spin if it's very powdery."
    ],
    [
     "Melt chocolate",
     "Melt the chocolate chips with the coconut oil in the microwave in 30-second bursts, stirring in between."
    ],
    [
     "Mix in",
     "Make a hole down to the bottom with a butter knife, pour in the melted chocolate and run Mix-in. The chocolate sets into creamy chips as it spins."
    ]
