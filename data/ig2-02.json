   "steps": [
    [
     "Marinate",
     "Toss the cutlets with lime zest and half the juice, garlic, salt, cumin and chili flakes for at least 15 minutes."
    ],
    [
     "Bread",
     "Dredge in flour, dip in egg and press into panko."
    ],
    [
     "Fry",
     "Shallow-fry in avocado oil 3–4 minutes per side until golden and cooked through. Toss with honey, the remaining lime juice and cilantro so it's glossy."
    ],
    [
     "Cucumbers",
     "Mix the cucumber with lime, cilantro, salt and vinegar; let it sit while the chicken cooks."
    ],
    [
     "Sauce",
     "Stir the yogurt or mayo with lime, garlic and salt."
    ],
    [
     "Build",
     "Spread sauce on the toasted bread, add the chicken, pile on the cucumbers and drizzle more sauce."
    ]
