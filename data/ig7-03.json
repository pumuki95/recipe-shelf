   "steps": [
    [
     "Roast",
     "Season the chuck roast and put it in a lidded oven dish with the garlic, onion and broth. Cook covered at 375°F for 2½ hours."
    ],
    [
     "Crisp",
     "Shred it, then return uncovered at 425°F for 30 minutes."
    ],
    [
     "Broth",
     "Cook the oil, curry paste, shallot and garlic 30 seconds, add the broth, cream, soy, lime, salt and honey and simmer a few minutes until slightly thick."
    ],
    [
     "Pickle",
     "Toss the cabbage with lime juice (or 3–4 tbsp cider vinegar) and salt; rest 5 minutes."
    ],
    [
     "Assemble",
     "Rice in bowls, 3–4 oz beef, pickled cabbage, herbs, sesame and half an egg; pour the warm broth around and squeeze over lime."
    ]
