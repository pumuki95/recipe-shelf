   "steps": [
    [
     "Marinate",
     "Mix the chicken with the seasonings, chipotle paste, lime juice and oil. Marinate, overnight if you can."
    ],
    [
     "Sauce",
     "Cook the onion in the butter over low heat 5–7 minutes, add the seasonings and chipotle paste and cook 5 more minutes. Stir in the evaporated milk and cream cheese until smooth."
    ],
    [
     "Potatoes",
     "Toss the potatoes with the seasoning and spray, spread on a lined sheet pan and roast at 200°C (390°F) for 25 minutes. Season with salt and fold into the sauce with parsley."
    ],
    [
     "Chicken",
     "Bake the chicken on a sheet pan at 200°C (390°F) for 25 minutes, then cube it."
    ],
    [
     "Portion",
     "Divide the creamy potatoes and chicken between 6 containers."
