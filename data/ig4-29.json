   "steps": [
    [
     "Cream",
     "Whisk the butter and sugars hard for about 3 minutes until light."
    ],
    [
     "Eggs",
     "Add the egg, yolk, vanilla and honey and whisk 3 more minutes until smooth."
    ],
    [
     "Dry",
     "Whisk the flour, cornstarch, baking powder, baking soda and salt, then fold into the wet until just combined. Fold in the chocolate."
    ],
    [
     "Chill",
     "Chill at least 2 hours in the fridge, or 45–60 minutes in the freezer (the key step)."
    ],
    [
     "Bake",
     "Heat the oven to 350°F (175°C). Scoop 6 tall mounds, spaced well apart, and bake 15 minutes until the edges are crisp and centers gooey."
    ]
