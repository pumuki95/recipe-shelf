   "steps": [
    [
     "Marinate",
     "Toss the chicken with all the marinade ingredients."
    ],
    [
     "Freeze",
     "Portion into bags and freeze flat right away, for up to 3–4 months."
    ],
    [
     "Thaw",
     "Thaw in the fridge and remove the lemongrass."
    ],
    [
     "Sauce (optional)",
     "For the nước chấm, stir the sugar and allulose into the water until dissolved, then add the lime juice, fish sauce, garlic and chili."
    ],
    [
     "Cook",
     "Pan-cook over medium heat, flipping halfway, until the chicken reaches 165°F."
    ],
    [
     "Serve",
