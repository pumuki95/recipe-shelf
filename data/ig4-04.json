   "steps": [
    [
     "Beef",
     "Soften the onion and garlic in the butter 5 minutes, add the beef and brown it, then stir in the seasonings, tomato paste and chipotle paste. Add a splash of water or broth."
    ],
    [
     "Assemble",
     "Spray a large sheet pan and dust with paprika. Dip each tortilla in the beef juices, lay it out, fill with mozzarella and beef and fold."
    ],
    [
     "Bake",
     "Bake 16 minutes, flipping halfway, until golden and crispy."
    ],
    [
     "Sides",
     "Mix the honey chipotle sauce and the pineapple pico in separate bowls and serve with the tacos."
    ]
   ],
